{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 119,
    "includes": ["**", "!docs/examples/**/*.json", "!schema/**/*.json"]
  },
  "files": {
    "includes": ["**", "!docs/_static/docson", "!docs/_templates", "!docs/_static/renderjson.*"]
  }
}
